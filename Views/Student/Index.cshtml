@{
    Layout = "_Layout";
    ViewData["Title"] = "Öğrenci Paneli";
}

<div class="dashboard-page">
    <header class="dashboard-header">
        <div>
            <p class="eyebrow">STAJ YÖNETİM SİSTEMİ</p>
            <h1>Öğrenci Paneli</h1>
            <p class="description">Staj evraklarınızı buradan yönetebilirsiniz.</p>
        </div>

        <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button class="secondary-button" type="submit">Çıkış Yap</button>
        </form>
    </header>

    <section class="panel-card upload-card">
        <div>
            <h2>Ek-16 evrakı</h2>
            <p class="description">Staj evrakınızı yüklemek için aşağıdaki butonu kullanın.</p>
        </div>

        <form asp-controller="Student" asp-action="Upload"
            method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="file" name="file"
                accept=".doc,.docx,.pdf,.jpg,.jpeg,.png" required />

            <button type="submit">Evrak Yükle</button>
        </form>
        @if (TempData["UploadMessage"] is string message)
        {
            <p class="form-message upload-message" role="status">@message</p>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/logout.js"></script>
}
